{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conclave-mr.local/projeto.schema.json",
  "title": "Projeto Pontuação Conclave (config + dados preenchidos)",
  "type": "object",
  "required": ["evento", "dados"],
  "properties": {
    "evento": { "$ref": "evento.schema.json" },
    "dados": {
      "type": "object",
      "required": ["participacao", "podium"],
      "properties": {
        "participacao": {
          "type": "object",
          "description": "Mapa { igrejaId → linha de participação }. Os campos `inscricao`/`pontualidade` aceitam booleano ou número (compatibilidade com planilhas).",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "inscricao": { "type": ["boolean", "number"] },
              "pontualidade": { "type": ["boolean", "number"] },
              "mr_total": { "type": "number" },
              "mr_camisa": { "type": "number" },
              "mr_biblia": { "type": "number" },
              "visitantes": { "type": "number" },
              "animacao": { "type": "boolean" },
              "mau_comportamento": { "type": "boolean" },
              "pontuacao_extra": { "type": "number" },
              "embaixadas": {
                "type": "number",
                "deprecated": true,
                "description": "Campo legado: usado como fallback quando `pontuacao_extra` está ausente. Novos eventos devem usar `pontuacao_extra`."
              }
            }
          }
        },
        "conservacaoTemploDescumprida": {
          "type": "boolean",
          "description": "Quando verdadeiro, soma `evento.pesos.conservacao_templo` às punições de todas as igrejas."
        },
        "podium": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "ou": { "$ref": "#/$defs/medalEntry" },
              "pt": { "$ref": "#/$defs/medalEntry" },
              "br": { "$ref": "#/$defs/medalEntry" }
            }
          }
        },
        "metricasEscrita": {
          "type": "object",
          "description": "Mapa { provaId → lista de participantes MR na prova escrita }. Não afeta a classificação geral.",
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/$defs/escritaParticipante" }
          }
        },
        "sorteioEsgrima": {
          "type": "object",
          "description": "Mapa { provaId → sessão de sorteio da Esgrima }. Não afeta a classificação geral.",
          "additionalProperties": {
            "$ref": "#/$defs/sorteioEsgrimaSessao"
          }
        }
      }
    }
  },
  "$defs": {
    "escritaParticipante": {
      "type": "object",
      "required": ["id", "nome", "igrejaId", "acertos"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$",
          "description": "Identificador estável gerado pelo app."
        },
        "nome": { "type": "string", "minLength": 1 },
        "igrejaId": { "type": "string" },
        "acertos": { "type": "number", "minimum": 0 }
      }
    },
    "sorteioEsgrimaSessao": {
      "type": "object",
      "properties": {
        "corpus": {
          "type": "string",
          "enum": ["biblia", "at", "nt", "evangelhos"]
        },
        "tempoSegundos": {
          "type": "integer",
          "minimum": 5,
          "maximum": 120
        },
        "usados": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Chaves já sorteadas (livro-capítulo-versículo), sem repetição."
        },
        "atual": {
          "type": ["string", "null"],
          "description": "Chave da referência em tela."
        },
        "historico": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Ordem em que as referências foram ditadas nesta sessão."
        }
      }
    },
    "medalEntry": {
      "type": "object",
      "properties": {
        "igrejaId": { "type": ["string", "null"] },
        "competidor": { "type": "string" },
        "nomeLivre": {
          "type": "string",
          "description": "Texto livre para identificar a igreja vencedora quando ela não está cadastrada em `evento.igrejas[]`. Ignorado pelo motor de pontuação; serve apenas para exibição/relatórios."
        }
      }
    }
  }
}
